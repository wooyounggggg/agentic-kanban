/* board.tcss — generated from theme template */

/* --------------------------------------------------------------------------
   App-wide defaults
   -------------------------------------------------------------------------- */
Screen {
    background: #2e3440;
    color: #eceff4;
}

/* --------------------------------------------------------------------------
   Header
   -------------------------------------------------------------------------- */
Header {
    background: #242933;
    color: #8fbcbb;
    text-style: bold;
    height: 1;
}

/* --------------------------------------------------------------------------
   Footer
   -------------------------------------------------------------------------- */
Footer {
    background: #242933;
    color: #4c566a;
    height: 1;
}

/* --------------------------------------------------------------------------
   Board layout
   -------------------------------------------------------------------------- */
#board-layout {
    height: 1fr;
    width: 100%;
}

/* --------------------------------------------------------------------------
   Sidebar
   -------------------------------------------------------------------------- */
Sidebar {
    background: #3b4252;
    border-right: solid #4c566a;
}

Sidebar.focused-mode {
    border-right: solid #88c0d0;
}

Sidebar .sb-title {
    color: #88c0d0;
}

Sidebar .sb-section {
    color: #4c566a;
}

Sidebar .sb-section-active {
    color: #88c0d0;
}

Sidebar .sb-item {
    color: #4c566a;
}

Sidebar .sb-item-current {
    color: #eceff4;
}

Sidebar .sb-item-hover {
    color: #88c0d0;
    background: #434c5e;
}

Sidebar .sb-hint {
    color: #4c566a;
}

/* --------------------------------------------------------------------------
   Columns area
   -------------------------------------------------------------------------- */
#board-columns {
    height: 1fr;
    width: 1fr;
    overflow-x: auto;
}

/* KanbanColumn */
KanbanColumn {
    width: 1fr;
    min-width: 22;
    height: 100%;
    margin: 0 1;
    border: round #4c566a;
    overflow-y: auto;
}

KanbanColumn .col-header {
    background: #3b4252;
    color: #8fbcbb;
    text-style: bold;
    padding: 0 1;
    text-align: center;
    height: 1;
}

KanbanColumn .col-empty {
    color: #4c566a;
    padding: 1;
    text-align: center;
    height: 3;
}

/* --------------------------------------------------------------------------
   Issue cards
   -------------------------------------------------------------------------- */
IssueCard {
    height: auto;
    padding: 0 1;
    margin: 1 1 0 1;
    border: tall #4c566a;
    background: #3b4252;
}

IssueCard:focus {
    border: tall #88c0d0;
    background: #434c5e;
}

IssueCard.selected {
    border: tall #88c0d0;
    background: #434c5e;
}
