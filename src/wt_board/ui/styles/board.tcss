/* board.tcss — generated from theme template */

/* --------------------------------------------------------------------------
   App-wide defaults
   -------------------------------------------------------------------------- */
Screen {
    background: #1d2021;
    color: #ebdbb2;
}

/* --------------------------------------------------------------------------
   Header
   -------------------------------------------------------------------------- */
Header {
    background: #141617;
    color: #fabd2f;
    text-style: bold;
    height: 1;
}

/* --------------------------------------------------------------------------
   Footer
   -------------------------------------------------------------------------- */
Footer {
    background: #141617;
    color: #665c54;
    height: 1;
}

/* --------------------------------------------------------------------------
   Board layout
   -------------------------------------------------------------------------- */
#board-layout {
    height: 1fr;
    width: 100%;
}

/* --------------------------------------------------------------------------
   Sidebar
   -------------------------------------------------------------------------- */
Sidebar {
    background: #282828;
    border-right: solid #504945;
}

Sidebar.focused-mode {
    border-right: solid #d79921;
}

Sidebar .sb-title {
    color: #d79921;
}

Sidebar .sb-section {
    color: #665c54;
}

Sidebar .sb-section-active {
    color: #d79921;
}

Sidebar .sb-item {
    color: #665c54;
}

Sidebar .sb-item-current {
    color: #ebdbb2;
}

Sidebar .sb-item-hover {
    color: #d79921;
    background: #3c3836;
}

Sidebar .sb-hint {
    color: #665c54;
}

/* --------------------------------------------------------------------------
   Columns area
   -------------------------------------------------------------------------- */
#board-columns {
    height: 1fr;
    width: 1fr;
    overflow-x: auto;
}

/* KanbanColumn */
KanbanColumn {
    width: 1fr;
    min-width: 22;
    height: 100%;
    margin: 0 1;
    border: round #504945;
    overflow-y: auto;
}

KanbanColumn .col-header {
    background: #282828;
    color: #fabd2f;
    text-style: bold;
    padding: 0 1;
    text-align: center;
    height: 1;
}

KanbanColumn .col-empty {
    color: #665c54;
    padding: 1;
    text-align: center;
    height: 3;
}

/* --------------------------------------------------------------------------
   Issue cards
   -------------------------------------------------------------------------- */
IssueCard {
    height: auto;
    padding: 0 1;
    margin: 1 1 0 1;
    border: tall #504945;
    background: #282828;
}

IssueCard:focus {
    border: tall #d79921;
    background: #3c3836;
}

IssueCard.selected {
    border: tall #d79921;
    background: #3c3836;
}
