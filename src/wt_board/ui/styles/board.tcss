/* board.tcss — generated from theme template */

/* --------------------------------------------------------------------------
   App-wide defaults
   -------------------------------------------------------------------------- */
Screen {
    background: #1a1b26;
    color: #c0caf5;
}

/* --------------------------------------------------------------------------
   Header
   -------------------------------------------------------------------------- */
Header {
    background: #13141c;
    color: #bb9af7;
    text-style: bold;
    height: 1;
}

/* --------------------------------------------------------------------------
   Footer
   -------------------------------------------------------------------------- */
Footer {
    background: #13141c;
    color: #565f89;
    height: 1;
}

/* --------------------------------------------------------------------------
   Board layout
   -------------------------------------------------------------------------- */
#board-layout {
    height: 1fr;
    width: 100%;
}

/* --------------------------------------------------------------------------
   Sidebar
   -------------------------------------------------------------------------- */
Sidebar {
    background: #24283b;
    border-right: solid #414868;
}

Sidebar.focused-mode {
    border-right: solid #7aa2f7;
}

Sidebar .sb-title {
    color: #7aa2f7;
}

Sidebar .sb-section {
    color: #565f89;
}

Sidebar .sb-section-active {
    color: #7aa2f7;
}

Sidebar .sb-item {
    color: #565f89;
}

Sidebar .sb-item-current {
    color: #c0caf5;
}

Sidebar .sb-item-hover {
    color: #7aa2f7;
    background: #414868;
}

Sidebar .sb-hint {
    color: #565f89;
}

/* --------------------------------------------------------------------------
   Columns area
   -------------------------------------------------------------------------- */
#board-columns {
    height: 1fr;
    width: 1fr;
    overflow-x: auto;
}

/* KanbanColumn */
KanbanColumn {
    width: 1fr;
    min-width: 22;
    height: 100%;
    margin: 0 1;
    border: round #414868;
    overflow-y: auto;
}

KanbanColumn .col-header {
    background: #24283b;
    color: #bb9af7;
    text-style: bold;
    padding: 0 1;
    text-align: center;
    height: 1;
}

KanbanColumn .col-empty {
    color: #565f89;
    padding: 1;
    text-align: center;
    height: 3;
}

/* --------------------------------------------------------------------------
   Issue cards
   -------------------------------------------------------------------------- */
IssueCard {
    height: auto;
    padding: 0 1;
    margin: 1 1 0 1;
    border: tall #414868;
    background: #24283b;
}

IssueCard:focus {
    border: tall #7aa2f7;
    background: #414868;
}

IssueCard.selected {
    border: tall #7aa2f7;
    background: #414868;
}
