/* detail.tcss — warm brown/earth-tone theme */

#detail-panel {
    height: 1fr;
    width: 100%;
    padding: 1;
    overflow-y: auto;
}

#detail-header {
    color: #d4ccc4;
    height: auto;
    margin-bottom: 1;
    border-bottom: solid #4a4440;
    padding-bottom: 1;
}

/* Section headers */
#cl-section-header,
#plan-section-header,
#worklog-section-header,
#desc-section-header,
#comments-section-header {
    color: #c4956a;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

/* Checklist */
ChecklistWidget {
    height: auto;
    max-height: 20;
    overflow-y: auto;
}

ChecklistWidget .cl-item {
    padding: 0 1;
    height: 1;
}

ChecklistWidget .cl-item.cl-selected {
    background: #3a3430;
}

ChecklistWidget .cl-item.cl-done {
    color: #7a7470;
}

/* Plan / Description / Comments viewer */
PlanViewer {
    height: auto;
    max-height: 24;
    overflow-y: auto;
    padding: 0 1;
    border: round #4a4440;
    text-align: left;
}

/* Fix markdown heading alignment */
PlanViewer Markdown {
    text-align: left;
}
PlanViewer Markdown H1 {
    text-align: left;
}
PlanViewer Markdown H2 {
    text-align: left;
}
PlanViewer Markdown H3 {
    text-align: left;
}
PlanViewer .markdown--h1,
PlanViewer .markdown--h2,
PlanViewer .markdown--h3 {
    text-align: left;
}

/* Worklog */
WorklogWidget {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    padding: 0 1;
}

WorklogWidget .wl-entry {
    border-bottom: dashed #2a2420;
    padding-bottom: 1;
    margin-bottom: 1;
    height: auto;
}

WorklogWidget .wl-empty {
    color: #7a7470;
    padding: 1;
}
