/* detail.tcss — 50/50 split detail screen */

/* --------------------------------------------------------------------------
   Layout
   -------------------------------------------------------------------------- */
#detail-layout {
    height: 1fr;
    width: 100%;
}

/* --------------------------------------------------------------------------
   Left panel — agent terminal
   -------------------------------------------------------------------------- */
#left-panel {
    width: 1fr;
    height: 100%;
    background: #0d1117;
    border-right: solid #30363d;
    padding: 1;
}

#agent-panel-header {
    color: #58a6ff;
    text-style: bold;
    height: 1;
    border-bottom: solid #30363d;
    margin-bottom: 1;
}

#agent-status {
    color: #c9d1d9;
    height: auto;
}

/* --------------------------------------------------------------------------
   Right panel — issue info
   -------------------------------------------------------------------------- */
#right-panel {
    width: 1fr;
    height: 100%;
    padding: 1;
    overflow-y: auto;
}

#detail-header {
    color: #c9d1d9;
    height: auto;
    margin-bottom: 1;
    border-bottom: solid #30363d;
    padding-bottom: 1;
}

/* --------------------------------------------------------------------------
   Section headers
   -------------------------------------------------------------------------- */
#cl-section-header,
#plan-section-header,
#worklog-section-header {
    color: #58a6ff;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

/* --------------------------------------------------------------------------
   Checklist
   -------------------------------------------------------------------------- */
ChecklistWidget {
    height: auto;
    max-height: 20;
    overflow-y: auto;
}

ChecklistWidget .cl-item {
    padding: 0 1;
    height: 1;
}

ChecklistWidget .cl-item.cl-selected {
    background: #0d419f;
}

ChecklistWidget .cl-item.cl-done {
    color: #6e7681;
}

/* --------------------------------------------------------------------------
   Plan viewer
   -------------------------------------------------------------------------- */
PlanViewer {
    height: auto;
    max-height: 24;
    overflow-y: auto;
    padding: 0 1;
    border: round #30363d;
}

/* --------------------------------------------------------------------------
   Worklog
   -------------------------------------------------------------------------- */
WorklogWidget {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    padding: 0 1;
}

WorklogWidget .wl-entry {
    border-bottom: dashed #21262d;
    padding-bottom: 1;
    margin-bottom: 1;
    height: auto;
}

WorklogWidget .wl-empty {
    color: #6e7681;
    padding: 1;
}
