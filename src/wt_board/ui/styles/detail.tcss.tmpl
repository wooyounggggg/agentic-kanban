/* detail.tcss — generated from theme template */

#detail-panel {{
    height: 1fr;
    width: 100%;
    padding: 1;
    overflow-y: auto;
}}

#detail-header {{
    color: {text};
    height: auto;
    margin-bottom: 1;
    border-bottom: solid {border};
    padding-bottom: 1;
}}

/* Section headers */
#cl-section-header,
#plan-section-header,
#worklog-section-header,
#desc-section-header,
#comments-section-header {{
    color: {accent};
    text-style: bold;
    height: 1;
    margin-top: 1;
}}

/* Checklist */
ChecklistWidget {{
    height: auto;
    max-height: 20;
    overflow-y: auto;
}}

ChecklistWidget .cl-item {{
    padding: 0 1;
    height: 1;
}}

ChecklistWidget .cl-item.cl-selected {{
    background: {surface_alt};
}}

ChecklistWidget .cl-item.cl-done {{
    color: {muted};
}}

/* Plan / Description / Comments viewer */
PlanViewer {{
    height: auto;
    max-height: 24;
    overflow-y: auto;
    padding: 0 1;
    border: round {border};
    text-align: left;
}}

/* Fix markdown heading alignment — MarkdownH1 DEFAULT_CSS uses content-align: center */
Markdown {{
    margin: 0;
    padding: 0;
}}

MarkdownH1 {{
    text-align: left;
    content-align: left top;
    color: {text};
}}

MarkdownH2 {{
    text-align: left;
    content-align: left top;
    color: {text};
}}

MarkdownH3 {{
    text-align: left;
    content-align: left top;
    color: {text};
}}

PlanViewer MarkdownH1 {{
    text-align: left;
    content-align: left top;
}}

PlanViewer MarkdownH2 {{
    text-align: left;
    content-align: left top;
}}

PlanViewer MarkdownH3 {{
    text-align: left;
    content-align: left top;
}}

/* Worklog */
WorklogWidget {{
    height: auto;
    max-height: 20;
    overflow-y: auto;
    padding: 0 1;
}}

WorklogWidget .wl-entry {{
    border-bottom: dashed {surface};
    padding-bottom: 1;
    margin-bottom: 1;
    height: auto;
}}

WorklogWidget .wl-empty {{
    color: {muted};
    padding: 1;
}}
