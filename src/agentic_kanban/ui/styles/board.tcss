/* board.tcss — generated from theme template */

/* --------------------------------------------------------------------------
   App-wide defaults
   -------------------------------------------------------------------------- */
Screen {
    background: #1a1612;
    color: #d4ccc4;
}

ModalScreen {
    background: rgba(0, 0, 0, 0.6);
}

/* --------------------------------------------------------------------------
   Header
   -------------------------------------------------------------------------- */
Header {
    background: #120e0a;
    color: #d4a57a;
    text-style: bold;
    height: 1;
}

/* --------------------------------------------------------------------------
   Footer
   -------------------------------------------------------------------------- */
Footer {
    background: #120e0a;
    color: #7a7470;
    height: 1;
}

/* --------------------------------------------------------------------------
   Board layout
   -------------------------------------------------------------------------- */
#board-layout {
    height: 1fr;
    width: 100%;
}

/* --------------------------------------------------------------------------
   Sidebar
   -------------------------------------------------------------------------- */
Sidebar {
    background: #2a2420;
    border-right: solid #4a4440;
}

Sidebar.focused-mode {
    border-right: solid #c4956a;
}

Sidebar .sb-title {
    color: #c4956a;
}

Sidebar .sb-section {
    color: #7a7470;
}

Sidebar .sb-section-active {
    color: #c4956a;
}

Sidebar .sb-item {
    color: #7a7470;
}

Sidebar .sb-item-current {
    color: #d4ccc4;
}

Sidebar .sb-item-hover {
    color: #c4956a;
    background: #3a3430;
}

Sidebar .sb-hint {
    color: #7a7470;
}

/* --------------------------------------------------------------------------
   Columns area
   -------------------------------------------------------------------------- */
#board-columns {
    height: 1fr;
    width: 1fr;
    overflow-x: auto;
}

/* KanbanColumn */
KanbanColumn {
    width: 1fr;
    min-width: 22;
    height: 100%;
    margin: 0 1;
    border: round #4a4440;
    overflow-y: auto;
}

KanbanColumn .col-header {
    background: #2a2420;
    color: #d4a57a;
    text-style: bold;
    padding: 0 1;
    text-align: center;
    height: 1;
}

KanbanColumn .col-empty {
    color: #7a7470;
    padding: 1;
    text-align: center;
    height: 3;
}

/* --------------------------------------------------------------------------
   Issue cards
   -------------------------------------------------------------------------- */
IssueCard {
    height: auto;
    padding: 0 1;
    margin: 1 1 0 1;
    border: tall #4a4440;
    background: #2a2420;
}

IssueCard:focus {
    border: tall #c4956a;
    background: #3a3430;
}

IssueCard.selected {
    border: tall #c4956a;
    background: #3a3430;
}
